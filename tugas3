#include <iostream>
using namespace std;

int total = 0;

void pesan(int harga) {
    int jml;
    cout << "Jumlah: ";
    cin >> jml;
    total = total + harga * jml;
}

int main() {
    int pilih;
    char lagi = 'y';

    while (lagi == 'y') {
        cout << "1. Soto 15000\n2. Rawon 20000\n3. Pecel 10000\n4. Teh 3000\n5. Kopi 5000\n";
        cout << "Pilih: ";
        cin >> pilih;

        if (pilih == 1) pesan(15000);
        else if (pilih == 2) pesan(20000);
        else if (pilih == 3) pesan(10000);
        else if (pilih == 4) pesan(3000);
        else if (pilih == 5) pesan(5000);
        else cout << "Menu salah\n";

        cout << "Tambah lagi (y/n)? ";
        cin >> lagi;
    }

    cout << "Total: " << total << endl;
    return 0;
}
